    "@react-pdf/renderer": "^4.1.6",
    "cheerio": "^1.0.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "next": "^15.1.4",
    "node-ical": "^0.20.1",
