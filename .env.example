# ============================================================
#  Golf in Hude – Wochenplan-Plattform · Umgebungsvariablen
#  Kopiere diese Datei zu ".env" und trage echte Werte ein.
#  NIEMALS echte Secrets committen.
# ============================================================

# --- Datenbank (PostgreSQL) -------------------------------------------------
# Lokal (Homebrew): postgresql://<user>@localhost:5432/golf_in_hude
# Produktion (Neon): postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/db?sslmode=require
DATABASE_URL="postgresql://localhost:5432/golf_in_hude"

# --- Ersteinrichtung des Administrators -------------------------------------
# Einmaliger Schlüssel, der zum Anlegen des ersten Admin-Kontos nötig ist.
# Nach erfolgreicher Einrichtung wird die Setup-Route dauerhaft gesperrt.
# Erzeuge z. B. mit: openssl rand -hex 32
ADMIN_SETUP_KEY="bitte-langen-zufaelligen-wert-eintragen"

# --- Sessions ----------------------------------------------------------------
# Secret zum Signieren/Ableiten von Session-Tokens. openssl rand -hex 32
SESSION_SECRET="bitte-langen-zufaelligen-wert-eintragen"

# --- Zeitzone ----------------------------------------------------------------
APP_TIMEZONE="Europe/Berlin"

# --- Öffentliche Basis-URL ---------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Speicher für generierte PDFs -------------------------------------------
# "local"        -> Dateisystem (Entwicklung)
# "netlify-blobs"-> Netlify Blobs (Produktion auf Netlify)
STORAGE_DRIVER="local"
LOCAL_STORAGE_DIR="./storage"
# Nur bei manueller (nicht auto-konfigurierter) Netlify-Blobs-Nutzung nötig:
# NETLIFY_BLOBS_SITE_ID=""
# NETLIFY_BLOBS_TOKEN=""

# --- Datenquellen (PC-CADDIE) -----------------------------------------------
PCCADDIE_CALENDAR_URL="https://www.pccaddie.net/clubs/0493369/app.php?cat=ts_calendar"
PCCADDIE_ICS_URL="https://www.golfcloud.com/clubs/0493369/app.php?cat=ts_calendar&sub=ics&openext=yes"

# --- Scheduler ---------------------------------------------------------------
# Geheimnis, das der Cron-Aufruf (Netlify Scheduled Function) mitsenden muss,
# damit /api/cron/generate ausgeführt wird. openssl rand -hex 32
CRON_SECRET="bitte-langen-zufaelligen-wert-eintragen"
